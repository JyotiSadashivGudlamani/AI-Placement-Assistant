# =============================================================================
# AI Placement Preparation Assistant - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# --- Backend Application ---
API_TITLE="AI Placement Preparation Assistant"
API_VERSION="2.0.0"
LOG_LEVEL="INFO"

# --- Ollama Local LLM Configuration ---
# Local Windows execution: http://127.0.0.1:11434
# Docker on Windows host:   http://host.docker.internal:11434
# Remote Ollama server:     http://<remote-ip>:11434
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL_NAME="llama3.2:3b"
OLLAMA_TIMEOUT_SECONDS=120.0

# --- MongoDB Database Configuration ---
# Local Windows execution: mongodb://localhost:27017
# Docker Compose:          mongodb://mongo:27017
# MongoDB Atlas Cloud:     mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="ai_placement_prep"

# --- Authentication & JWT Security ---
# IMPORTANT: Generate a strong, unique secret key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="ai_placement_prep_jwt_super_secret_key_change_in_prod_778899"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Vector Store & ChromaDB ---
# Path for persistent vector storage
CHROMA_DB_DIR="backend/chroma_db"
DEFAULT_COLLECTION_NAME="placement_documents"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
DEFAULT_TOP_K=4
MIN_SIMILARITY_THRESHOLD=0.20

# --- Document Ingestion & Chunking ---
DEFAULT_CHUNK_SIZE=300
DEFAULT_CHUNK_OVERLAP=50
MAX_FILE_SIZE_BYTES=15728640

# --- CORS Allowed Origins ---
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:80,http://127.0.0.1:80"

# --- Frontend (Vite) ---
VITE_API_URL="http://127.0.0.1:8000"
